# --- Required ---
# Password for the app (single user). Anything long and random.
APP_PASSWORD=change-me
# Claude API key for the conversation partner: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Optional ---
# Model for the conversation partner (default: claude-opus-5-5).
# claude-sonnet-5-5 or claude-haiku-5-5 are faster and cheaper if replies feel slow.
CLAUDE_MODEL=claude-opus-5-5
# Thinking effort for conversation turns (low keeps replies fast) and for end-of-session summaries.
CLAUDE_EFFORT=low
CLAUDE_SUMMARY_EFFORT=medium
# Server-side refusal fallback: "default" (recommended) or "off".
CLAUDE_FALLBACKS=default

# Your time zone (used for "today" in /api/stats). Example: America/New_York
TZ=America/New_York

# Speech-to-text fallback: any OpenAI-compatible /v1/audio/transcriptions endpoint.
# Self-hosted (docker compose --profile whisper):
#   STT_URL=http://whisper:8000/v1/audio/transcriptions
#   STT_MODEL=Systran/faster-whisper-small
# Hosted OpenAI:
#   STT_URL=https://api.openai.com/v1/audio/transcriptions
#   STT_MODEL=whisper-1
#   STT_API_KEY=sk-...
STT_URL=
STT_MODEL=Systran/faster-whisper-small
STT_API_KEY=

# Optional bearer token for /api/stats (for your dashboard). If unset, /api/stats is readable without auth.
STATS_TOKEN=

# Dev only: fake AI replies without an API key.
MOCK_AI=0
