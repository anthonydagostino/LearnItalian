{
  "topic": "adjectives",
  "title": "Adjectives & Adverbs",
  "items": [
    {
      "it": "bene",
      "en": "well; fine",
      "ex": "Parli molto bene!",
      "ex_en": "You speak very well!",
      "kind": "word",
      "level": 1,
      "notes": "Sto bene = I'm fine. Va bene = OK."
    },
    {
      "it": "molto",
      "en": "very; a lot, much",
      "ex": "È molto bello.",
      "ex_en": "It's very beautiful.",
      "kind": "word",
      "level": 1,
      "notes": "As an adjective it agrees: molta gente, molti turisti."
    },
    {
      "it": "buono",
      "en": "good (taste, quality)",
      "ex": "Questa pizza è molto buona.",
      "ex_en": "This pizza is very good.",
      "kind": "word",
      "level": 1,
      "notes": "Before a masculine singular noun: buon (buon vino), but buono before s+consonant or z (buono studente). Feminine buona (buon' before a vowel: buon'idea); plural buoni, buone."
    },
    {
      "it": "bello",
      "en": "beautiful, nice, good-looking",
      "ex": "Che bella giornata!",
      "ex_en": "What a beautiful day!",
      "kind": "word",
      "level": 1,
      "notes": "Before a noun it changes like the article: bel posto, bello zaino, bell'albergo; plural bei, begli. Feminine bella, belle."
    },
    {
      "it": "grande",
      "en": "big, large; great",
      "ex": "La camera è molto grande.",
      "ex_en": "The room is very big.",
      "kind": "word",
      "level": 1,
      "notes": "Same form for masculine and feminine; plural grandi. Before a noun often means 'great': un grande artista."
    },
    {
      "it": "piccolo",
      "en": "small, little",
      "ex": "Vorrei una birra piccola.",
      "ex_en": "I'd like a small beer.",
      "kind": "word",
      "level": 1
    },
    {
      "it": "troppo",
      "en": "too; too much",
      "ex": "È troppo caro.",
      "ex_en": "It's too expensive.",
      "kind": "word",
      "level": 1,
      "notes": "As an adjective it agrees: troppa gente, troppi turisti."
    },
    {
      "it": "poco",
      "en": "little, not much; not very",
      "ex": "Mangio poco la sera.",
      "ex_en": "I don't eat much in the evening.",
      "kind": "word",
      "level": 1,
      "notes": "Un po' (short for un poco) = a little: un po' di pane. As an adjective it agrees: pochi soldi. Plural pochi, poche."
    },
    {
      "it": "più",
      "en": "more; most",
      "ex": "Questo è più caro.",
      "ex_en": "This one is more expensive.",
      "kind": "word",
      "level": 1,
      "notes": "più… di = more… than: più alto di me."
    },
    {
      "it": "meno",
      "en": "less; minus",
      "ex": "Questo è meno caro.",
      "ex_en": "This one is less expensive.",
      "kind": "word",
      "level": 1,
      "notes": "Also used in telling time: le otto meno dieci = ten to eight."
    },
    {
      "it": "ancora",
      "en": "still; yet; again; more",
      "ex": "Sei ancora qui?",
      "ex_en": "Are you still here?",
      "kind": "word",
      "level": 1,
      "notes": "Non ancora = not yet. Ancora un po' = a little more."
    },
    {
      "it": "già",
      "en": "already",
      "ex": "Ho già mangiato, grazie.",
      "ex_en": "I've already eaten, thanks.",
      "kind": "word",
      "level": 1,
      "notes": "Già! on its own = Right! / Exactly."
    },
    {
      "it": "adesso / ora",
      "en": "now",
      "ex": "Adesso non posso.",
      "ex_en": "I can't right now.",
      "kind": "word",
      "level": 1,
      "notes": "Interchangeable. Ora is also a noun: l'ora = the hour."
    },
    {
      "it": "qui / qua",
      "en": "here",
      "ex": "Vieni qui!",
      "ex_en": "Come here!",
      "kind": "word",
      "level": 1,
      "notes": "Interchangeable; qua is slightly more colloquial."
    },
    {
      "it": "lì / là",
      "en": "there",
      "ex": "Il bagno è lì.",
      "ex_en": "The bathroom is there.",
      "kind": "word",
      "level": 1,
      "notes": "Interchangeable. Mind the accents: without them, li is a pronoun and la is an article or pronoun."
    },
    {
      "it": "solo",
