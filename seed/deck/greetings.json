{
  "topic": "greetings",
  "title": "Greetings & Basics",
  "items": [
    {
      "it": "ciao",
      "en": "hi; bye (informal)",
      "ex": "Ciao, Marco! Come va?",
      "ex_en": "Hi, Marco! How's it going?",
      "kind": "word",
      "level": 1,
      "notes": "informal: friends, family, young people"
    },
    {
      "it": "buongiorno",
      "en": "good morning; hello (until mid-afternoon)",
      "ex": "Buongiorno, signora! Come sta?",
      "ex_en": "Good morning, ma'am! How are you?",
      "kind": "word",
      "level": 1,
      "notes": "also used as a goodbye during the day",
      "flag": "When people switch to buonasera varies by region; in much of central/southern Italy it starts right after lunch (~1-2 p.m.)."
    },
    {
      "it": "grazie",
      "en": "thank you; thanks",
      "ex": "Grazie per l'aiuto!",
      "ex_en": "Thanks for the help!",
      "kind": "word",
      "level": 1
    },
    {
      "it": "prego",
      "en": "you're welcome; please, go ahead",
      "ex": "Grazie! — Prego!",
      "ex_en": "Thank you! — You're welcome!",
      "kind": "word",
      "level": 1,
      "notes": "also 'after you', 'come in', 'please do'"
    },
    {
      "it": "per favore",
      "en": "please",
      "ex": "Un momento, per favore.",
      "ex_en": "One moment, please.",
      "kind": "word",
      "level": 1,
      "notes": "also 'per piacere'"
    },
    {
      "it": "sì",
      "en": "yes",
      "ex": "Sei americano? — Sì.",
      "ex_en": "Are you American? — Yes.",
      "kind": "word",
      "level": 1,
      "notes": "with accent; 'si' without accent is a pronoun"
    },
    {
      "it": "no",
      "en": "no",
      "ex": "No, non sono italiano.",
      "ex_en": "No, I'm not Italian.",
      "kind": "word",
      "level": 1
    },
    {
      "it": "scusi",
      "en": "excuse me; sorry (formal)",
      "ex": "Scusi, dov'è il bagno?",
      "ex_en": "Excuse me, where's the restroom?",
      "kind": "word",
      "level": 1,
      "notes": "formal (Lei): to get attention or apologize"
    },
    {
      "it": "scusa",
      "en": "excuse me; sorry (informal)",
      "ex": "Scusa, hai un minuto?",
      "ex_en": "Excuse me, do you have a minute?",
      "kind": "word",
      "level": 1,
      "notes": "informal (tu)"
    },
    {
      "it": "permesso",
      "en": "excuse me (to get past); may I come in?",
      "ex": "Permesso, devo scendere.",
      "ex_en": "Excuse me, I need to get off.",
      "kind": "word",
      "level": 1,
      "notes": "to get past people, or when entering someone's home"
    },
    {
      "it": "buonasera",
      "en": "good evening; hello (from mid/late afternoon)",
      "ex": "Buonasera, signor Rossi!",
      "ex_en": "Good evening, Mr. Rossi!",
      "kind": "word",
      "level": 1,
      "notes": "also used as a goodbye in the evening"
    },
    {
      "it": "arrivederci",
      "en": "goodbye",
      "ex": "Grazie di tutto, arrivederci!",
      "ex_en": "Thanks for everything, goodbye!",
      "kind": "word",
      "level": 1,
      "notes": "safe in both formal and informal situations"
    },
    {
      "it": "piacere",
      "en": "nice to meet you; pleasure",
      "ex": "Piacere, sono Anna.",
      "ex_en": "Nice to meet you, I'm Anna.",
      "kind": "word",
      "level": 1,
      "notes": "said with a handshake when introduced"
    },
    {
      "it": "buonanotte",
      "en": "good night",
      "ex": "Buonanotte, dormi bene!",
      "ex_en": "Good night, sleep well!",
      "kind": "word",
      "level": 1,
      "notes": "only when parting late at night or going to bed"
    },
    {
      "it": "certo",
      "en": "of course; sure",
      "ex": "Posso sedermi? — Certo!",
      "ex_en": "May I sit down? — Of course!",
      "kind": "word",
      "level": 1
    },
    {
      "it": "la signora",
      "en": "lady; ma'am; Mrs.",
      "ex": "Grazie, signora!",
      "ex_en": "Thank you, ma'am!",
      "kind": "word",
      "level": 1,
      "notes": "no article when addressing someone directly; la signora Bianchi = Mrs. Bianchi"
    },
    {
      "it": "americano",
      "en": "American",
      "ex": "Mio marito è americano.",
      "ex_en": "My husband is American.",
      "kind": "word",
      "level": 1,
      "notes": "f. americana"
    },
    {
      "it": "italiano",
      "en": "Italian",
      "ex": "Sei italiano? — No, americano.",
      "ex_en": "Are you Italian? — No, American.",
      "kind": "word",
      "level": 1,
      "notes": "f. italiana; l'italiano = the Italian language"
    },
    {
      "it": "il nome",
      "en": "name; first name",
      "ex": "Scriva il nome qui, per favore.",
      "ex_en": "Write your name here, please.",
      "kind": "word",
      "level": 1
    },
    {
      "it": "Come stai?",
      "en": "How are you? (informal)",
      "ex": "Ciao, Luca! Come stai?",
      "ex_en": "Hi, Luca! How are you?",
      "kind": "phrase",
      "level": 1
    },
    {
      "it": "Come sta?",
      "en": "How are you? (formal)",
      "ex": "Buongiorno, signora. Come sta?",
      "ex_en": "Good morning, ma'am. How are you?",
      "kind": "phrase",
      "level": 1
    },
    {
      "it": "Bene, grazie.",
      "en": "Fine, thanks.",
      "ex": "Come stai? — Bene, grazie.",
      "ex_en": "How are you? — Fine, thanks.",
      "kind": "phrase",
      "level": 1
    },
    {
      "it": "Sto bene.",
      "en": "I'm fine; I'm well.",
      "ex": "Sto bene, grazie. E tu?",
      "ex_en": "I'm fine, thanks. And you?",
      "kind": "phrase",
      "level": 1
    },
    {
      "it": "E tu?",
      "en": "And you? (informal)",
      "ex": "Mi chiamo Tom, e tu?",
      "ex_en": "My name is Tom, and you?",
      "kind": "phrase",
      "level": 1
    },
    {
      "it": "E Lei?",
      "en": "And you? (formal)",
      "ex": "Bene, grazie. E Lei?",
      "ex_en": "Fine, thanks. And you?",
      "kind": "phrase",
      "level": 1,
      "notes": "formal Lei is often capitalized in writing"
    },
    {
      "it": "Come va?",
      "en": "How's it going?",
      "ex": "Ciao! Come va? — Non c'è male.",
      "ex_en": "Hi! How's it going? — Not bad.",
      "kind": "phrase",
      "level": 1,
      "notes": "works in both formal and informal situations"
    },
    {
      "it": "Mi chiamo…",
      "en": "My name is…",
      "ex": "Ciao, mi chiamo David.",
      "ex_en": "Hi, my name is David.",
      "kind": "phrase",
      "level": 1,
      "notes": "lit. 'I call myself…'"
    },
    {
      "it": "Come ti chiami?",
      "en": "What's your name? (informal)",
      "ex": "Come ti chiami? — Mi chiamo Sara.",
      "ex_en": "What's your name? — My name is Sara.",
      "kind": "phrase",
      "level": 1
    },
    {
      "it": "Come si chiama?",
      "en": "What's your name? (formal)",
      "ex": "Scusi, come si chiama? — Mario Bianchi.",
      "ex_en": "Excuse me, what's your name? — Mario Bianchi.",
      "kind": "phrase",
      "level": 1
    },
    {
      "it": "Di dove sei?",
      "en": "Where are you from? (informal)",
      "ex": "Di dove sei? — Sono di Chicago.",
      "ex_en": "Where are you from? — I'm from Chicago.",
      "kind": "phrase",
      "level": 1
    },
    {
      "it": "Di dov'è?",
      "en": "Where are you from? (formal)",
      "ex": "Scusi, di dov'è? — Sono americano.",
